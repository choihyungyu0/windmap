# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. (.env.local 은 git에 커밋되지 않음)
# 서버 전용 키 — NEXT_PUBLIC_ 접두사를 붙이지 마세요(클라이언트 노출 금지).

# 관리자 페이지(/admin)는 공모전 시연용으로 인증 없이 공개 (robots noindex 만 적용)

# ── 데이터 수집 (engine/ Python 파이프라인) ──
# 공공데이터포털 서비스 키 (CleanSYS TMS · 기상청 · 에어코리아 공용 계정 키)
DATA_GO_KR_SERVICE_KEY=

# ── Supabase (배포용 공유 저장소 — 파이프라인 상태·경보 이력) ──
# 선행: supabase/schema.sql 을 대시보드 SQL Editor 에서 1회 실행
# SERVICE_ROLE 키는 전권 키 — 절대 클라이언트/리포에 노출 금지
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM 경보 권고문 생성 (P5 · F-ALT-03, 실패 시 템플릿 폴백)
ANTHROPIC_API_KEY=

# 관제 대시보드 시설 위치 지도 (카카오맵 JavaScript 키)
# 카카오 개발자 콘솔에 사이트 도메인(localhost:3000·배포 도메인) 등록 필요.
# JS 키는 도메인 제한으로 보호되는 공개용 키라 NEXT_PUBLIC_ 노출 가능.
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
